{
	"name": "@hyperupcall/npm-package-json-lint-config",
	"version": "0.3.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/hyperupcall-projects/npm-package-json-lint-config"
	},
	"bugs": {
		"url": "https://github.com/hyperupcall-projects/npm-package-json-lint-config/issues"
	},
	"author": "Edwin Kofler <edwin@kofler.dev> (https://edwinkofler.com)",
	"private": false,
	"packageManager": "pnpm@12.23.0",
	"exports": {
		".": {
			"types": "./index.d.cts",
			"default": "./index.cjs"
		}
	},
	"files": [
		"./index.cjs",
		"./index.d.cts"
	],
	"scripts": {
		"format": "hyperupcall-scripts-nodejs format",
		"lint": "hyperupcall-scripts-nodejs lint"
	},
	"devDependencies": {
		"@hyperupcall/scripts-nodejs": "0.17.0",
		"npm-package-json-lint": "11.0.1"
	},
	"commitlint": {
		"extends": "/storage/extras/Documents/Computing/Experiments/commitlint-config"
	},
	"markdownlint-cli2": {
		"extends": "./node_modules/@hyperupcall/scripts-nodejs/.markdownlint.mjs"
	},
	"npmpackagejsonlint": {
		"extends": "@hyperupcall/scripts-nodejs/config-npmpackagejsonlint.js"
	},
	"prettier": "@hyperupcall/scripts-nodejs/config-prettier.js"
}
